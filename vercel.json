{
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{__pycache__/**,**/*.pyc,**/*.pyo,**/*.pyd,*.png,*.zip}"
    }
  },
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}